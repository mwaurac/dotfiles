# ╭─────────────────────────────────────────────╮
# │  mako — Catppuccin Mocha                    │
# │  Sleek Wayland notification daemon          │
# ╰─────────────────────────────────────────────╯

font=FiraCode Nerd Font 10
background-color=#1e1e2e
text-color=#cdd6f4
border-color=#313244
border-size=2
border-radius=8
width=300
height=110
margin=10
padding=12
default-timeout=5000
max-visible=5
sort=-time

[urgency=low]
background-color=#1e1e2e
border-color=#313244
default-timeout=3000

[urgency=normal]
background-color=#1e1e2e
border-color=#cba6f7
text-color=#cdd6f4
default-timeout=6000

[urgency=high]
background-color=#1e1e2e
border-color=#f38ba8
text-color=#f38ba8
default-timeout=0
